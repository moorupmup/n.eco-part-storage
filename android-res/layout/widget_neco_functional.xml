<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_functional_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Summary Line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N.ECO Быстрый склад"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_fn_stock_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 шт (0 нов / 0 б/у)"
            android:textColor="#38bdf8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4 Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 1. Search Button -->
        <LinearLayout
            android:id="@+id/widget_btn_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_search"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Поиск"
                android:textColor="#e4e4e7"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Write-off Button (Списать) -->
        <LinearLayout
            android:id="@+id/widget_btn_writeoff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_rose"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➖"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Списать"
                android:textColor="#fda4af"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Stock In Button (Приход) -->
        <LinearLayout
            android:id="@+id/widget_btn_stock_in"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_emerald"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➕"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Приход"
                android:textColor="#6ee7b7"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. Deficit Button -->
        <LinearLayout
            android:id="@+id/widget_btn_deficit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/widget_fn_deficit_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_fn_deficit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Заказ"
                android:textColor="#f59e0b"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
